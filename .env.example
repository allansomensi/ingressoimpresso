# API (crates/server). Copy to .env for local development; never commit .env.
DATABASE_URL=postgres://ingressoimpresso:ingressoimpresso@127.0.0.1:5432/ingressoimpresso
# 32 random bytes, base64: `openssl rand -base64 32`. Losing it means rotating every event key.
TICKET_KEY_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
ADMIN_EMAILS=voce@exemplo.com
# Optional locally (codes are printed in the log without it); required with APP_ENV=production.
RESEND_API_KEY=
MAIL_FROM=Ingresso Impresso <login@mail.seudominio.com.br>

# Web (apps/web): where the browser calls the API.
NEXT_PUBLIC_API_URL=http://localhost:8080
