  "query": "update changelog_entries\n           set kind = $2, title = $3, body = $4, updated_at = now(),\n               published_at = case when $5 then coalesce(published_at, now()) end\n           where id = $1\n           returning id, kind, title, body, published_at, created_at, updated_at",
