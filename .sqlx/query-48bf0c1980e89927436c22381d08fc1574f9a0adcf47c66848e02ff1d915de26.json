  "query": "select t.id, t.email::text as \"email!\", coalesce(t.name, u.name) as name, t.areas,\n                  t.user_id, t.created_at\n           from event_team t left join users u on u.id = t.user_id\n           where t.event_id = $1 order by t.created_at",
